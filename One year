        function loadLocalStorage() {
            const savedBucket = localStorage.getItem('jj_katy_bucket');
            if (savedBucket) bucketList = JSON.parse(savedBucket);
        }

        function startTimer() {
            function update() {
                const now = new Date().getTime();
                const diff = Math.max(0, now - START_DATE);

                const days = Math.floor(diff / (1000 * 60 * 60 * 24));
                const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
                const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
                const seconds = Math.floor((diff % (1000 * 60)) / 1000);

                document.getElementById('countDays').innerText = days.toLocaleString();
                document.getElementById('countHours').innerText = hours.toLocaleString();
                document.getElementById('countMinutes').innerText = minutes.toLocaleString();
                document.getElementById('countSeconds').innerText = seconds &lt; 10 ? '0' + seconds : seconds;
            }
            update();
            setInterval(update, 1000);
        }

        function renderTimeline() {
            const container = document.getElementById('timelineContainer');
            container.innerHTML = '';

            milestones.forEach((m, idx) =&gt; {
                const isLeft = idx % 2 === 0;
                const card = document.createElement('div');
                card.className = `flex items-center justify-between w-full flex-col md:flex-row ${isLeft ? 'md:flex-row-reverse' : ''} group`;
                
                card.innerHTML = `
                    &lt;div class=&quot;hidden md:block w-5/12&quot;&gt;&lt;/div&gt;
                    &lt;div class=&quot;z-20 flex items-center justify-center bg-rose-600 text-white w-10 h-10 rounded-full shadow-lg border-4 border-white dark:border-darkbg group-hover:scale-125 transition-transform my-2 md:my-0&quot;&gt;
                        &lt;i data-lucide=&quot;${m.icon}&quot; class=&quot;w-5 h-5&quot;&gt;&lt;/i&gt;
