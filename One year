            { id: 6, category: &quot;Everyday Joy&quot;, title: &quot;Simple Errands&quot;, desc: &quot;Making simple daily errands feel like a fun date because we were together.&quot;, tag: &quot;Joy&quot;, icon: &quot;shopping-bag&quot; }
